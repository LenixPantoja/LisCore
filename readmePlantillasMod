            <textarea matInput rows="3" [formControlName]="element.id"></textarea>
            <mat-hint *ngIf="element.help">{{ element.help }}</mat-hint>
          </mat-form-field>
        </ng-container>

        <!-- Radio buttons -->
        <ng-container *ngIf="element.type === 'Radio'">
          <label class="radio-group-label">{{ element.name }}</label>
          <mat-radio-group [formControlName]="element.id" class="radio-group">
            <mat-radio-button *ngFor="let opt of element.options" [value]="opt">
