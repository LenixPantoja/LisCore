  `,
  styles: [
    '.full-width { width: 100%; }',
    '.template-title { margin: 16px 0 8px; color: #1976d2; }',
    '.radio-group-label { display: block; margin-bottom: 8px; font-weight: 500; }',
    '.radio-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }',
  ],
})
export class CompoundTemplateFormComponent implements OnInit {
  @Input() elements: TemplateElement[] = [];
  @Input() formGroup!: FormGroup;

  constructor(private fb: FormBuilder) {}

  ngOnInit(): void {
    const controls: Record<string, any> = {};
    for (const el of this.elements) {
      controls[el.id] = [el.defaultValue || ''];
    }
    this.formGroup = this.fb.group(controls);
  }

  /** Devuelve los valores actuales del formulario como objeto clave-valor */
  getValues(): Record<string, string> {
    return this.formGroup.value;
  }
}
```

## 9. Uso en una página de completado de resultados

```typescript
// En tu componente de resultados de laboratorio (ej: LaboratoryResultComponent)

import { Component, OnInit } from '@angular/core';
import { CompoundTemplateService } from '../../services/compound-template.service';
import { CompoundTemplate, TemplateElement } from '../../models/compound-template.model';

@Component({
  selector: 'app-laboratory-result',
  template: `
    <ng-container *ngIf="template">
      <h4>{{ template.ct_name }}</h4>
      <p *ngIf="template.ct_description">{{ template.ct_description }}</p>
      <app-compound-template-form
        [elements]="templateElements"
        [formGroup]="compoundForm"
      ></app-compound-template-form>
      <button mat-raised-button color="primary" (click)="saveResult()">
        Guardar Resultado
      </button>
    </ng-container>
  `,
})
export class LaboratoryResultComponent implements OnInit {
  compoundForm!: FormGroup;

  template: CompoundTemplate | null = null;
  templateElements: TemplateElement[] = [];

  // Estos vendrían del contexto: orden, estudio, test seleccionados
  testId = 5;        // ID del TestsLab
  laboratoryId = 10; // l_id del Laboratory donde guardar el resultado

  constructor(
    private templateService: CompoundTemplateService,
    private resultService: ResultService, // tu servicio para guardar resultados
  ) {}

  ngOnInit(): void {
    this.loadTemplate();
  }

  loadTemplate(): void {
    this.templateService.getTemplatesForTest(this.testId).subscribe({
      next: (templates) => {
        if (templates.length > 0) {
          this.template = templates[0]; // usar la primera/por defecto
          this.templateElements = this.template.ct_template.template;
        }
      },
      error: (err) => console.error('Error loading template', err),
    });
  }

  saveResult(): void {
    const formValues = this.compoundForm.getValues();
    // Convertir a formato de resultado compuesto (ej: concatenar, guardar como JSON, etc.)
    const l_result_comp = JSON.stringify(formValues);

    // Guardar en el laboratorio
    this.resultService.updateLaboratory(this.laboratoryId, {
      l_result_comp,
    }).subscribe({
      next: () => console.log('Result saved'),
      error: (err) => console.error('Error saving', err),
    });
  }
}
```

