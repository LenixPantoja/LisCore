## 7. Servicio Angular (HTTP Client)

```typescript
// src/app/domains/compound-templates/services/compound-template.service.ts

import { Injectable } from '@angular/core';
import { HttpClient, HttpParams } from '@angular/common/http';
import { Observable } from 'rxjs';
import {
  CompoundTemplate,
  CompoundTemplateCreate,
  CompoundTemplatePaginated,
  TestCompoundTemplateLink,
} from '../models/compound-template.model';

@Injectable({ providedIn: 'root' })
export class CompoundTemplateService {
  private baseUrl = '/api/compound-templates';

  constructor(private http: HttpClient) {}

  // ── CRUD Plantillas ──────────────────────────────────────────────────

  list(skip = 0, limit = 100, search?: string, activeOnly = false): Observable<CompoundTemplatePaginated> {
    let params = new HttpParams().set('skip', skip).set('limit', limit);
    if (search) params = params.set('search', search);
    if (activeOnly) params = params.set('active_only', 'true');
    return this.http.get<CompoundTemplatePaginated>(this.baseUrl, { params });
  }

  getById(ctId: number): Observable<CompoundTemplate> {
    return this.http.get<CompoundTemplate>(`${this.baseUrl}/${ctId}`);
  }

  create(data: CompoundTemplateCreate): Observable<CompoundTemplate> {
    return this.http.post<CompoundTemplate>(this.baseUrl, data);
  }

  update(ctId: number, data: Partial<CompoundTemplateCreate>): Observable<CompoundTemplate> {
    return this.http.put<CompoundTemplate>(`${this.baseUrl}/${ctId}`, data);
  }

  delete(ctId: number): Observable<{ success: boolean; message: string }> {
    return this.http.delete<{ success: boolean; message: string }>(`${this.baseUrl}/${ctId}`);
  }

  // ── Vínculos N:M ─────────────────────────────────────────────────────

  getTemplatesForTest(testId: number): Observable<CompoundTemplate[]> {
    return this.http.get<CompoundTemplate[]>(`${this.baseUrl}/by-test/${testId}`);
  }

  linkTest(ctId: number, testId: number, isDefault = false): Observable<TestCompoundTemplateLink> {
    return this.http.post<TestCompoundTemplateLink>(`${this.baseUrl}/${ctId}/tests`, {
      tct_test_id: testId,
      tct_is_default: isDefault,
    });
  }

  getLinkedTests(ctId: number): Observable<TestCompoundTemplateLink[]> {
    return this.http.get<TestCompoundTemplateLink[]>(`${this.baseUrl}/${ctId}/tests`);
  }

  unlinkTest(tctId: number): Observable<{ success: boolean; message: string }> {
    return this.http.delete<{ success: boolean; message: string }>(`${this.baseUrl}/tests/${tctId}`);
  }
}
```

