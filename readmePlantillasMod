// src/app/domains/compound-templates/models/compound-template.model.ts

/** Un elemento individual del template (campo dinámico del formulario) */
export interface TemplateElement {
  id: string;
  name: string;
  type: 'T' | 'Combo' | 'Text' | 'TextArea' | 'Radio';
  typeName?: string;
