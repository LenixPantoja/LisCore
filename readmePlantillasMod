# Plantillas Dinámicas de Resultados - Integración Angular

## 1. SQL para crear las tablas (ejecutar en PostgreSQL)

```sql
-- =============================================================================
-- CompoundTemplates: Plantillas dinámicas de completado de resultados
-- =============================================================================
CREATE TABLE "CompoundTemplates" (
    ct_id           SERIAL PRIMARY KEY,
    ct_name         VARCHAR(255) NOT NULL,
    ct_description  TEXT,
    ct_template     JSONB NOT NULL DEFAULT '{"template": []}'::jsonb,
    ct_active       BOOLEAN NOT NULL DEFAULT TRUE,
    ct_created_at   TIMESTAMP NOT NULL DEFAULT NOW(),
    ct_updated_at   TIMESTAMP NOT NULL DEFAULT NOW()
);

-- =============================================================================
-- TestCompoundTemplates: Pivote N:M entre TestsLab y CompoundTemplates
-- =============================================================================
CREATE TABLE "TestCompoundTemplates" (
    tct_id           SERIAL PRIMARY KEY,
    tct_test_id      INTEGER NOT NULL REFERENCES "TestsLab"(id) ON DELETE CASCADE,
    tct_template_id  INTEGER NOT NULL REFERENCES "CompoundTemplates"(ct_id) ON DELETE CASCADE,
    tct_is_default   BOOLEAN NOT NULL DEFAULT FALSE,
    tct_order_index  INTEGER NOT NULL DEFAULT 0,
    tct_created_at   TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Índices para búsquedas rápidas
CREATE INDEX ix_TestCompoundTemplates_test_id     ON "TestCompoundTemplates"(tct_test_id);
CREATE INDEX ix_TestCompoundTemplates_template_id ON "TestCompoundTemplates"(tct_template_id);

-- Unique: un test no puede estar vinculado 2 veces a la misma plantilla
CREATE UNIQUE INDEX uq_TestCompoundTemplates_test_template
    ON "TestCompoundTemplates"(tct_test_id, tct_template_id);
```

